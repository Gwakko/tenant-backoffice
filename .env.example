# Local development values only. Copy to .env (make does it automatically).
# None of these are secrets; do not reuse them anywhere else.

# Postgres container and role passwords (used by make db-bootstrap)
TB_POSTGRES_PASSWORD=postgres
TB_OWNER_PASSWORD=tb_owner_dev
TB_APP_PASSWORD=tb_app_dev
TB_DB_NAME=tenant_backoffice

# Service addresses as seen from containers on the compose network.
# On a CI runner, point TB_DB_HOST/TB_DB_PORT at the host-side service.
TB_DB_HOST=postgres
TB_DB_PORT=5432

# Published host ports (change to avoid conflicts with other processes)
TB_POSTGRES_HOST_PORT=5432
TB_API_HOST_PORT=8080
TB_WEB_HOST_PORT=8088

# API
TB_HTTP_ADDR=:8080
TB_LOG_LEVEL=info
TB_LOG_FORMAT=json
TB_DB_CONNECT_TIMEOUT=30s
TB_JWT_ACTIVE_KID=k2026a
TB_ACCESS_TTL=10m
TB_REFRESH_TTL=168h
TB_CURRENCY=EUR
# TB_CURSOR_KEY is generated by `make keys` into keys/cursor.env
