.DEFAULT_GOAL := help

# Settings come from .env (copied from .env.example on first use) and keys/cursor.env.
-include .env
-include keys/cursor.env
export

# Tool runners. Locally the targets run inside compose containers; CI runs them
# on the host with: make ci-inner GO= NPM= PSQL="psql -h 127.0.0.1"
GO   ?= docker compose run --rm -T go-tools
NPM  ?= docker compose run --rm -T web-tools
PSQL ?= docker compose exec -T postgres psql

TB_DB_NAME  ?= tenant_backoffice
TB_JWT_ACTIVE_KID ?= k2026a
GOTESTFLAGS ?=

.PHONY: help env up down logs db-bootstrap keys migrate seed gen gen-check gen-check-go gen-check-web web-install \
	lint lint-go lint-web typecheck \
	test-unit test-int test-iso test-api test-web migrate-roundtrip ec-check ec-report check-hosts build \
	ci ci-inner ci-go ci-web e2e e2e-inner

help:
	@grep -E '^[a-z-]+:' Makefile | cut -d: -f1 | sort

.env:
	cp .env.example .env
	@echo "created .env from .env.example"

env: .env

up: .env
	docker compose up -d --build --wait postgres api web

down:
	docker compose --profile tools --profile e2e down

logs:
	docker compose logs -f --tail=100

# Creates roles and the application database. Run as the Postgres superuser; idempotent.
db-bootstrap: .env
	$(PSQL) -U postgres -v ON_ERROR_STOP=1 \
		-v owner_password='$(TB_OWNER_PASSWORD)' -v app_password='$(TB_APP_PASSWORD)' -v db_name='$(TB_DB_NAME)' \
		-f - < backend/db/bootstrap/roles.sql

# Ed25519 JWT signing key and the pagination cursor HMAC key (local dev only; both git-ignored).
keys:
	mkdir -p keys
	test -f keys/$(TB_JWT_ACTIVE_KID).pem || openssl genpkey -algorithm ed25519 -out keys/$(TB_JWT_ACTIVE_KID).pem
	chmod 0644 keys/$(TB_JWT_ACTIVE_KID).pem
	test -f keys/cursor.env || echo "TB_CURSOR_KEY=$$(openssl rand -base64 32)" > keys/cursor.env

# Web client. Targets run inside web-tools locally and on the host in CI (NPM=).
# web/node_modules is installed on demand; web-install always runs `npm ci` (reproducible, from the lockfile).
WEB_STAMP := web/node_modules/.package-lock.json

$(WEB_STAMP): web/package-lock.json web/package.json
	cd web && $(NPM) npm ci

web-install:
	cd web && $(NPM) npm ci

typecheck: $(WEB_STAMP)
	cd web && $(NPM) npm run typecheck

# T-ARCH-04: eslint (no-explicit-any, layer rules) and no `eslint-disable` in web sources
# (routeTree.gen.ts is generated by the router plugin and ignored by eslint).
lint-web: $(WEB_STAMP)
	@if grep -rn --exclude=routeTree.gen.ts "eslint-disable" web/src web/vite.config.ts web/eslint.config.js web/eslint/arch.js; then \
		echo "lint-web: eslint-disable is forbidden (T-ARCH-04)"; exit 1; fi
	cd web && $(NPM) npm run lint

build: $(WEB_STAMP)
	cd web && $(NPM) npm run build

# Generates Go DTOs and the strict server interface from api/openapi.yaml (oapi-codegen, version pinned
# by the `tool` directive in backend/go.mod) and web/src/api/schema.d.ts (openapi-typescript).
GEN_DIR := internal/adapter/httpapi/gen

gen: $(WEB_STAMP)
	cd backend && $(GO) go generate ./$(GEN_DIR)/...
	cd web && $(NPM) npm run gen

# T-CI-03: regenerates into scratch files and fails when a committed generated file differs.
# The Go half runs inside go-tools (no node there), the web half needs web/node_modules.
gen-check: gen-check-go gen-check-web

gen-check-go:
	cd backend && trap 'rm -f gen.check.tmp' EXIT; \
		$(GO) go tool oapi-codegen -config $(GEN_DIR)/config.yaml -o gen.check.tmp ../api/openapi.yaml && \
		{ diff -u $(GEN_DIR)/api.gen.go gen.check.tmp || { echo "gen-check: api.gen.go is stale, run make gen"; exit 1; }; } && \
		echo "gen-check: api.gen.go ok"

gen-check-web: $(WEB_STAMP)
	cd web && trap 'rm -f schema.check.tmp' EXIT; \
		$(NPM) npx --no-install openapi-typescript ../api/openapi.yaml -o schema.check.tmp >/dev/null && \
		{ diff -u src/api/schema.d.ts schema.check.tmp || { echo "gen-check: schema.d.ts is stale, run make gen"; exit 1; }; } && \
		echo "gen-check: schema.d.ts ok"

# Applies migrations to the application database as tb_owner (TB_DB_MIGRATE_URL).
migrate:
	cd backend && $(GO) go run ./cmd/migrate up

# up -> down to 0 -> up on a scratch database created through TB_TEST_DB_ADMIN_URL (T-CI-01).
migrate-roundtrip:
	cd backend && $(GO) go run ./cmd/migrate roundtrip

test-int:
	cd backend && $(GO) go test -race -tags integration $(GOTESTFLAGS) ./...

# Tenant isolation suite (T-ISO): real Postgres, connected as tb_app.
test-iso:
	cd backend && $(GO) go test -race -count=1 -tags integration $(GOTESTFLAGS) ./internal/isolation/...

# Loads backend/seed/demo.json under the owner role (TB_DB_MIGRATE_URL); a second run changes nothing.
# SEED_FLAGS=-force skips the refusal to run on foreign data.
seed:
	cd backend && $(GO) go run ./cmd/seed $(SEED_FLAGS)

# API suite (T-A): the real API over a real Postgres. One regex without `|` on purpose: GOTESTFLAGS is
# expanded unquoted by the shell, so every API test is named TestAPI... and one prefix selects them all.
test-api:
	cd backend && $(GO) go test -race -count=1 -tags integration -run 'TestAPI' $(GOTESTFLAGS) ./internal/adapter/httpapi/...

test-web: $(WEB_STAMP)
	cd web && $(NPM) npm test

# Browser suite (T-E, spec 08 section 3.6). The scenarios change data, so a run never touches the
# development database: it creates the throw-away database $(E2E_DB) in the compose Postgres, migrates
# and seeds it, starts api and web on it, runs Playwright in the `playwright` container (web reached as
# http://web:8080 inside the compose network), and removes the containers and the database afterwards,
# also when the run fails. Reports land in web/playwright-report and web/test-results.
E2E_DB := tb_e2e

e2e: .env keys $(WEB_STAMP)
	@set -e; \
	cleanup() { \
		docker compose --profile e2e rm -sf playwright web api >/dev/null 2>&1 || true; \
		$(PSQL) -U postgres -c 'DROP DATABASE IF EXISTS $(E2E_DB) WITH (FORCE)' >/dev/null 2>&1 || true; \
	}; \
	trap cleanup EXIT; \
	cleanup; \
	$(MAKE) --no-print-directory TB_DB_NAME=$(E2E_DB) db-bootstrap migrate seed up; \
	rm -rf web/playwright-report web/test-results; \
	TB_DB_NAME=$(E2E_DB) docker compose --profile e2e run --rm -T playwright npx playwright test

# On a runner: the stack is already up, Playwright and its browser are installed on the host
# (npm ci in web/, npx playwright install --with-deps chromium) and E2E_BASE_URL is set.
e2e-inner:
	cd web && npx playwright test

# Directories searched for Test-ID markers (Go tests, web unit tests, the web lint rules, e2e).
ECCHECK_ROOTS ?= .,../web/src,../web/e2e,../web/eslint

lint: lint-go lint-web

lint-go:
	cd backend && $(GO) golangci-lint run ./...

test-unit:
	cd backend && $(GO) go test -race $(GOTESTFLAGS) ./...

# Edge-case coverage (T-CI-05, spec 11). Soft mode: report only, never fails on gaps.
# Strict mode (no -soft) becomes part of ci-go in M6.3.
ec-check:
	cd backend && $(GO) go run ./tools/eccheck -roots $(ECCHECK_ROOTS)

ec-report:
	cd backend && $(GO) go run ./tools/eccheck -soft -markdown -roots $(ECCHECK_ROOTS)

# Hosts must come from the environment, never hard-coded into code or scripts (T-CI-04).
# Service hostnames in connection strings, plus localhost/127.0.0.1 literals in tests and web sources.
CHECK_HOSTS_PATHS := $(wildcard web/e2e web/src web/vite.config.ts)
check-hosts:
	@if grep -rnE '@(postgres|redis)[:/]' backend --include='*.go' --include='*.sh' --include='*.yaml'; then \
		echo "check-hosts: hard-coded service host found"; exit 1; fi
	@if grep -rnE 'localhost:[0-9]+|127\.0\.0\.1' backend --include='*_test.go'; then \
		echo "check-hosts: hard-coded address in a Go test"; exit 1; fi
	@if [ -n "$(CHECK_HOSTS_PATHS)" ] && grep -rnE 'localhost:[0-9]+|127\.0\.0\.1' $(CHECK_HOSTS_PATHS); then \
		echo "check-hosts: hard-coded address in web sources"; exit 1; fi
	@echo "check-hosts: ok"

# Local CI: Go targets run inside go-tools (on the host, containers are not nested);
# web targets run on the host and go through $(NPM) into web-tools.
ci: .env
	docker compose run --rm -T go-tools make -C /workspace ci-go GO= NPM= PSQL=
	$(MAKE) ci-web

# Runs in the current environment (used on the Actions runner, with GO= NPM= PSQL=).
ci-inner: ci-go ci-web

# Goal list per spec 08 section 5: gen-check (Go half here, web half in ci-web) lint-go check-hosts test-unit migrate-roundtrip test-int test-iso test-api ec-check.
# ec-check is strict since M6.3: every edge case has its tests, every marker is declared in spec 08.
ci-go: gen-check-go lint-go check-hosts test-unit migrate-roundtrip test-int test-iso test-api ec-check

# Goal list per spec 08 section 5: npm ci typecheck lint-web test-web build, plus gen-check-web for schema.d.ts.
ci-web: web-install gen-check-web typecheck lint-web test-web build
